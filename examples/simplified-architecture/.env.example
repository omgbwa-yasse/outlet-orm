# Database driver: sqlite | mysql | postgres
DB_DRIVER=sqlite

# SQLite — path to database file (use :memory: for in-memory demo)
DB_FILE=./database.sqlite

# MySQL / PostgreSQL — uncomment and fill in when using those drivers
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=secret
# DB_NAME=outlet_demo

# Server port
PORT=3000
