# ─── AiBridge — Environment Variables ─────────────────────────────
# Copy the variables you need into your project's .env file.
# Only providers with a configured API key / endpoint will be activated.

# Default provider (openai, ollama, claude, gemini, grok, mistral, onn, openai_custom, openrouter)
AI_DEFAULT_PROVIDER=openai

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
# OPENAI_EMBEDDINGS_ENDPOINT=https://api.openai.com/v1/embeddings
# OPENAI_IMAGES_ENDPOINT=https://api.openai.com/v1/images/generations
# OPENAI_AUDIO_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
# OPENAI_AUDIO_STT_ENDPOINT=https://api.openai.com/v1/audio/transcriptions

# ─── Ollama (local) ──────────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Ollama Turbo (cloud) ────────────────────────────────────────
# OLLAMA_TURBO_API_KEY=
# OLLAMA_TURBO_ENDPOINT=https://ollama.com
# OLLAMA_TURBO_MODEL=llama3.2

# ─── Claude (Anthropic) ──────────────────────────────────────────
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages

# ─── Gemini (Google) ─────────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ─── Grok (xAI) ──────────────────────────────────────────────────
# GROK_API_KEY=
# GROK_MODEL=grok-1
# GROK_ENDPOINT=https://api.x.ai/v1/chat/completions

# ─── Mistral ─────────────────────────────────────────────────────
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions

# ─── ONN ──────────────────────────────────────────────────────────
# ONN_API_KEY=
# ONN_MODEL=onn-medium
# ONN_ENDPOINT=https://api.onn.ai/v1/completions

# ─── Custom OpenAI-compatible (Azure, OpenRouter, proxy) ─────────
# OPENAI_CUSTOM_API_KEY=
# OPENAI_CUSTOM_BASE_URL=
# OPENAI_CUSTOM_MODEL=
# OPENAI_CUSTOM_AUTH_HEADER=Authorization
# OPENAI_CUSTOM_AUTH_PREFIX=Bearer
# OPENAI_CUSTOM_PATH_CHAT=/chat/completions
# OPENAI_CUSTOM_PATH_EMBEDDINGS=/embeddings
# OPENAI_CUSTOM_PATH_MODELS=/models

# ─── OpenRouter ──────────────────────────────────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# ─── Global AI settings ─────────────────────────────────────────
# AI_MAX_FILE_BYTES=10485760
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.7
# AI_MAX_TOOL_ITERATIONS=5
